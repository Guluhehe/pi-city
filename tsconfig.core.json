{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "src/adapters/pi/**/*.ts",
    "src/semantic-trace/**/*.ts",
    "src/experience/**/*.ts",
    "src/world/cues.ts",
    "src/analysis/**/*.ts"
  ]
}
